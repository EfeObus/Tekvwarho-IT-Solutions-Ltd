# Dependencies
node_modules/

# Environment
.env
.env.local
.env.production

# Service account keys / credentials - never commit these
Keys/
*.json.key
service-account*.json

# Logs
logs/
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Build outputs
dist/
build/

# Temporary files
tmp/
temp/

# Beta app binaries - deployed via `gcloud run deploy --source .` directly,
# not tracked in git history to avoid bloating it with binary rebuilds
downloads/*.apk
downloads/*.ipa
