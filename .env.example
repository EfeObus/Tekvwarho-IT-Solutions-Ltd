# Environment Variables
# Copy this file to .env and fill in your values

# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tekvwa
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# Email Configuration (SMTP - Google Workspace)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@tekvwa.org
SMTP_PASS=your_google_workspace_app_password
EMAIL_FROM=noreply@tekvwa.org

# Admin Configuration
ADMIN_EMAIL=info@tekvwa.org
ADMIN_PASSWORD=change_this_password

# Site Configuration
SITE_URL=https://tekvwa.org
SITE_NAME=Tekvwa IT Solutions
